<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_quick_select" model="ir.ui.view">
        <field name="name">sale.order.form.quick.product.select</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']/field[@name='order_line']" position="before">
                <widget name="quick_product_select"
                        groups="sales_team.group_sale_salesman"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
